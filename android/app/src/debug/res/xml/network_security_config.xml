<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Scoped exclusively to Debug builds for local development testing (Emulator 10.0.2.2, ADB Reverse 127.0.0.1, LAN Wi-Fi HTTP) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
